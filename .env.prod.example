# ============================================================
#  服务器部署用环境变量模板（配合 docker-compose.prod.yml）
#  用法：复制成 .env 后填真实值，和 docker-compose.prod.yml
#  一起放到服务器同一个目录，然后：
#    docker compose -f docker-compose.prod.yml pull
#    docker compose -f docker-compose.prod.yml up -d
#
#  建议在服务器上直接生成密码，不要在自己电脑上造好再传（可以照抄这几行）：
#    cd /home/ticket
#    DB_PASSWORD=$(openssl rand -hex 24)
#    JWT_SECRET=$(openssl rand -hex 32)
#    ADMIN_PASSWORD=$(openssl rand -hex 16)
#    sed -i "s|^DB_PASSWORD=.*|DB_PASSWORD=$DB_PASSWORD|" .env
#    sed -i "s|^JWT_SECRET=.*|JWT_SECRET=$JWT_SECRET|" .env
#    sed -i "s|^ADMIN_PASSWORD=.*|ADMIN_PASSWORD=$ADMIN_PASSWORD|" .env
#    chmod 600 .env          # 只有 root 能读
#    echo "$ADMIN_PASSWORD"  # 抄到密码管理器，别发聊天里
# ============================================================

# ---------- 镜像（GHCR 拉取） ----------
# 镜像前缀 = ghcr.io/<GitHub用户名>/<仓库名>，全部小写。
# 实际镜像会是 <前缀>-backend 和 <前缀>-frontend，由 compose 自动拼接。
# 例：GitHub 仓库是 github.com/zhangsan/sap-registration-system
#     就填 IMAGE_PREFIX=ghcr.io/zhangsan/sap-registration-system
IMAGE_PREFIX=ghcr.io/your-github-username/your-repo-name
# 默认 latest（每次 push 自动更新）；回滚时改成上一版的 sha-xxxxxxx
IMAGE_TAG=latest

# ---------- 数据库 ----------
DB_USER=ticket
# 密码只能用字母、数字、下划线；含 @ : / ? # 等字符会破坏 DATABASE_URL
DB_PASSWORD=change-me-strong-password
DB_NAME=ticket

# ---------- 后端服务 ----------
# 后台登录令牌的签名密钥，泄露等于别人能伪造管理员登录
# 生成方式：openssl rand -hex 32
JWT_SECRET=change-me-to-a-32-plus-char-random-string
JWT_EXPIRE_HOURS=12

# 首次启动时自动创建的后台管理员账号（账号已存在时不会被覆盖）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ---------- 运行时 ----------
TZ=Asia/Shanghai
UPLOAD_DIR=/app/uploads

# 前端监听端口：本系统在服务器上只用 7000（7000~7003 里挑一个没被占用的），
# 对外由服务器已有的 Caddy 做 HTTPS 反代（见 Caddyfile.snippet），
# 所以这里不要填 80/443，也不要把 7000 开进安全组。
FRONTEND_PORT=7000

# 部署后到后台「邮件设置」里把 public_base_url 改成 https://你的域名，
# 否则邮件里的报名链接会是 http 或 localhost。
