# ===== 依赖与缓存（别人 npm install / 容器启动会自己生成）=====
node_modules/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ===== 构建产物 =====
dist/
build/
*.egg-info/

# ===== 运行数据（跟数据库一起备份，不进代码仓库）=====
uploads/
output/
*.log

# ===== 内网穿透工具：二进制和运行产物不入库（文件留在本地照样能用）=====
# cloudflared.exe 55MB，超过 GitHub 单文件建议上限
tools/tunnel/cloudflared.exe
tools/tunnel/tunnel.log
tools/tunnel/public-url.txt

# ===== 密钥与本地配置：绝对不能进仓库 =====
.env
.env.local
.env.*.local
!.env.example

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db
