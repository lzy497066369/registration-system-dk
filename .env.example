# ============================================================
#  冬季家庭主题活动报名系统 —— 环境变量模板
#  用法：复制成 .env 后填真实值（.env 不进代码仓库）
#  cp .env.example .env        或在 Windows 下手工复制改名
# ============================================================

# ---------- 数据库（compose 里的 postgres 容器） ----------
# 只在容器内部使用，不需要对外开放端口
DB_USER=ticket
# 密码只能用字母、数字、下划线；含 @ : / ? # 等字符会破坏 DATABASE_URL
DB_PASSWORD=change-me-strong-password
DB_NAME=ticket

# ---------- 后端服务 ----------
# 后台登录令牌的签名密钥，泄露等于别人能伪造管理员登录
# 生成方式：openssl rand -hex 32   或随便敲 32 位以上无规律字符
JWT_SECRET=change-me-to-a-32-plus-char-random-string
# 登录状态有效期（小时）
JWT_EXPIRE_HOURS=12

# 首次启动时自动创建的后台管理员账号
# 注意：账号已存在时不会被覆盖，改这里不会改掉线上已有密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ---------- 运行时 ----------
TZ=Asia/Shanghai
# 上传图片的落盘目录，容器内路径，对应 compose 里的 uploads 卷
UPLOAD_DIR=/app/uploads

# ---------- 对外端口 ----------
# 本机开发用 5280；服务器上要改成 80（配了 HTTPS 的话由反向代理转过来）
FRONTEND_PORT=5280
